local TargetIndicator = {}
TargetIndicator.Visible = false
TargetIndicator.Target = nil
TargetIndicator.Position = Vector2.new(40, 40)

local PlayersService = game:GetService("Players")
local RunService = game:GetService("RunService")

local HeadshotFolder = "radon_hs"
if not isfolder(HeadshotFolder) then makefolder(HeadshotFolder) end
local HeadshotCache = {}

local function GetHeadshot(player)
    if HeadshotCache[player.UserId] then return HeadshotCache[player.UserId] end
    local path = HeadshotFolder .. "/" .. tostring(player.UserId) .. ".png"
    if not isfile(path) then
        local url = "https://www.roblox.com/headshot-thumbnail/image?userId="
            .. tostring(player.UserId) .. "&width=150&height=150&format=png"
        local ok, data = pcall(game.HttpGet, game, url)
        if not ok or not data or #data < 100 then return nil end
        writefile(path, data)
    end
    local ok, asset = pcall(getcustomasset, path)
    if not ok then return nil end
    HeadshotCache[player.UserId] = asset
    return asset
end

local Card = {
    Width = 320,
    Height = 88,
    Padding = 8,
    ImageSize = 64,
    Background = Color3.fromRGB(18, 18, 20),
    BackgroundTransparency = 0.1,
    Outline = Color3.fromRGB(50, 50, 56),
    Bar = Color3.new(0, 0, 0),
    NameSize = 15,
    DistanceSize = 13,
}

local Draw = {
    Bg = Drawing.new("Square"),
    Outline = Drawing.new("Square"),
    Image = Drawing.new("Image"),
    ImageBorder = Drawing.new("Square"),
    Name = Drawing.new("Text"),
    Distance = Drawing.new("Text"),
    HealthBar = Drawing.new("Square"),
    HealthFill = Drawing.new("Square"),
}

Draw.Bg.Filled = true
Draw.Bg.Color = Card.Background
Draw.Bg.Transparency = Card.BackgroundTransparency
Draw.Outline.Filled = false
Draw.Outline.Thickness = 1
Draw.Outline.Color = Card.Outline
Draw.ImageBorder.Filled = false
Draw.ImageBorder.Thickness = 1
Draw.ImageBorder.Color = Color3.fromRGB(50, 50, 56)
Draw.Name.Size = Card.NameSize
Draw.Name.Center = false
Draw.Name.Outline = true
Draw.Name.OutlineColor = Color3.new(0, 0, 0)
Draw.Name.Color = Color3.fromRGB(255, 255, 255)
Draw.Distance.Size = Card.DistanceSize
Draw.Distance.Center = false
Draw.Distance.Outline = true
Draw.Distance.OutlineColor = Color3.new(0, 0, 0)
Draw.Distance.Color = Color3.fromRGB(190, 190, 195)
Draw.HealthBar.Filled = true
Draw.HealthBar.Color = Card.Bar
Draw.HealthFill.Filled = true

local lastImage = nil

local function Hide()
    for _, obj in pairs(Draw) do obj.Visible = false end
end

function TargetIndicator.SetTarget(player) TargetIndicator.Target = player end
function TargetIndicator.ClearTarget() TargetIndicator.Target = nil end
function TargetIndicator.SetVisible(bool) TargetIndicator.Visible = bool end
function TargetIndicator.SetPosition(vec) TargetIndicator.Position = vec end
function TargetIndicator.Destroy()
    for _, obj in pairs(Draw) do obj:Remove() end
end

RunService.RenderStepped:Connect(function()
    local player = TargetIndicator.Target
    if not TargetIndicator.Visible or not player or not player.Character then
        Hide()
        return
    end
    local char = player.Character
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then Hide() return end

    local x = math.floor(TargetIndicator.Position.X)
    local y = math.floor(TargetIndicator.Position.Y)
    local pad = Card.Padding
    local img = Card.ImageSize
    local textX = x + pad + img + pad

    Draw.Bg.Visible = true
    Draw.Bg.Position = Vector2.new(x, y)
    Draw.Bg.Size = Vector2.new(Card.Width, Card.Height)

    Draw.Outline.Visible = true
    Draw.Outline.Position = Vector2.new(x, y)
    Draw.Outline.Size = Vector2.new(Card.Width, Card.Height)

    local asset = GetHeadshot(player)
    if asset then
        if lastImage ~= asset then
            Draw.Image.Image = asset
            lastImage = asset
        end
        Draw.Image.Visible = true
        Draw.Image.Position = Vector2.new(x + pad, y + (Card.Height - img) / 2)
        Draw.Image.Size = Vector2.new(img, img)
        Draw.ImageBorder.Visible = true
        Draw.ImageBorder.Position = Vector2.new(x + pad, y + (Card.Height - img) / 2)
        Draw.ImageBorder.Size = Vector2.new(img, img)
    else
        Draw.Image.Visible = false
        Draw.ImageBorder.Visible = false
    end

    Draw.Name.Visible = true
    Draw.Name.Text = player.DisplayName
    Draw.Name.Position = Vector2.new(textX, y + 12)

    local dist = (workspace.CurrentCamera.CFrame.Position - char.HumanoidRootPart.Position).Magnitude
    Draw.Distance.Visible = true
    Draw.Distance.Text = tostring(math.floor(dist)) .. "st"
    Draw.Distance.Position = Vector2.new(textX, y + 30)

    local health = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
    local barW = Card.Width - (textX - x) - pad
    local barY = y + Card.Height - pad - 8
    Draw.HealthBar.Visible = true
    Draw.HealthBar.Position = Vector2.new(textX, barY)
    Draw.HealthBar.Size = Vector2.new(barW, 6)
    Draw.HealthFill.Visible = true
    Draw.HealthFill.Position = Vector2.new(textX, barY)
    Draw.HealthFill.Size = Vector2.new(barW * health, 6)
    Draw.HealthFill.Color = Color3.fromRGB(math.floor(255 * (1 - health)), math.floor(255 * health), 0)
end)

return TargetIndicator
